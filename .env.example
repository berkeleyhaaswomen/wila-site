# Copy this file to .env.local and fill in the values.
# The public site builds and renders without these. Content falls back to the
# hardcoded defaults in lib/content.ts. The admin site at /admin needs them.

# --- Database (required for /admin) ---------------------------------------
# Any Postgres provider works. Free options: Neon (neon.tech), Supabase,
# Vercel Postgres. Copy the "connection string" / "pooled connection" value.
DATABASE_URL=

# --- Session signing key (required for /admin) ----------------------------
# Must be at least 32 characters and kept secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# --- Photo uploads (optional) ---------------------------------------------
# Uploads work without this: photos are resized and stored in Postgres, then
# served from /api/images/<id>. Set this only if you would rather keep photos
# on a CDN. From Vercel → Storage → Blob → the store's "Read/Write Token".
BLOB_READ_WRITE_TOKEN=
