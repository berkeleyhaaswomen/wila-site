# Copy this file to .env.local and fill in the values from sanity.io/manage
# The site will build and deploy even without these — content falls back to
# the hardcoded defaults in lib/content.ts.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional: a read-only token if you set your dataset to Private.
# Leave blank if you use the default Public dataset.
SANITY_API_READ_TOKEN=
